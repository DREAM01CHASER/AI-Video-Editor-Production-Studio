[TEMPLATE]
# Optional local workspace override. Relative paths are resolved from the repository root.
AI_VIDEO_WORKSPACE=workspace

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_SIZE_MB=500

# --- Optional LLM pass for clip labels (off unless a key is set) ---
# When set, candidate clips get model-written titles, reasons, and scores. Clip
# start/end times always come from the transcript. If the call fails for any
# reason, the transparent heuristic result is used instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Optional Pexels stock B-roll search (off unless a key is set) ---
# When set, the Stock search panel can find stock clips, show their preview and
# credit, and import a chosen one into the project's asset library. The key stays
# server-side and is never sent to the browser. Leave empty to keep the app fully
# local: the local B-roll and sound-effect library works with no key at all.
PEXELS_API_KEY=

# Pexels REST API root. Override only to point at a compatible endpoint.
PEXELS_BASE_URL=https://api.pexels.com

# --- Local transcription (faster-whisper) ---

# Model size: tiny, base, small, medium, large-v3, distil-large-v3, or a path to a
# converted CTranslate2 model directory. Weights download on first use and are
# then reused from the local model cache.
WHISPER_MODEL=medium

# auto, cpu, or cuda. "auto" prefers a CUDA device when CTranslate2 can see one, and
# falls back to CPU if the GPU runtime (cuDNN/cuBLAS) is missing.
WHISPER_DEVICE=auto

# auto, int8, float16, int8_float16, or float32.
# "auto" means float16 on GPU and int8 on CPU.
WHISPER_COMPUTE_TYPE=auto

# ISO language code such as "en". Leave empty to detect the language automatically.
WHISPER_LANGUAGE=

# Beam search width. Higher is more accurate and noticeably slower.
WHISPER_BEAM_SIZE=5

# Request word-level timings for captions. Falls back to segment timings when the
# model cannot produce them.
WHISPER_WORD_TIMESTAMPS=true

# Allow downloading model weights on first use. Set to false to stay offline; the
# transcription then reports a clear error unless the model is already cached.
WHISPER_ALLOW_DOWNLOAD=true

# Worker threads used on CPU. 0 lets CTranslate2 choose.
WHISPER_CPU_THREADS=0

# Optional model cache override. Empty uses the normal Hugging Face cache.
WHISPER_MODEL_CACHE_DIR=
